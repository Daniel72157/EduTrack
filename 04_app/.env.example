# Copia este archivo a .env.local (local) o cárgalo en Vercel > Settings > Environment Variables.
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543) para la app.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-48-bytes
